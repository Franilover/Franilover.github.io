              if (label) {
                await supabase
                  .from("map_areas")
                  .update({ label })
                  .eq("id", selectedAreaId);
                setAreas((prev) =>
                  prev.map((a) =>
                    a.id === selectedAreaId ? { ...a, label } : a,
                  ),
                );
                await invalidateMapAreas("garlia");
              }
