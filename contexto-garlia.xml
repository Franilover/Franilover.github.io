  const headerControls = {
    imagenUrl: form.mapa_url,
    IconoFallback: Map,
    nombre: form.nombre ?? "",
    placeholderNombre: "Nombre del reino",
    onChangeNombre: (nombre: string) => setForm((f) => ({ ...f, nombre })),
    status,
    onGuardar: save,
    onEliminar: del,
