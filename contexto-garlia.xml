function useCiudadesDelReino(reinoId: string) {
  const [ciudades, setCiudades] = useState<Ciudad[]>([]);

  useEffect(() => {
    let cancelled = false;
    void loadCiudadesPorReino(reinoId, (data) => {
      if (!cancelled) setCiudades(data as Ciudad[]);
    }).then((data) => {
