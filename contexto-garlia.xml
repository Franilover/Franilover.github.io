  return (
    <ComboSelector
      allowNone
      emptyText="Sin personajes"
      icon={<Mic2 size={10} />}
      items={items}
      loading={loading}
      mode="single"
      noneLabel="Ninguno"
      placeholder="Sin narrador…"
      value={value}
      onChange={onChange}
      onNavigate={onNavigate ? (id) => onNavigate(id) : undefined}
    />
  );
};
