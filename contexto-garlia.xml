              value={target}
              onChange={(e) => setTarget(e.target.value)}
            />
            <div style={{ ...S.sublabel, marginTop: 4 }}>
              Creá primero una Sección en este capítulo.
            </div>
          </div>
        )}
        <button
          disabled={!snippet}
          style={S.insertBtn("#5aabf5")}
          onClick={() => snippet && onInsert(snippet)}
