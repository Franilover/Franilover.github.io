              ))}
            </div>
          </div>
        ) : (
          <div>
            <div style={S.fieldLabel}>ID de sección destino</div>
            <input
              placeholder="ej: cofre-secreto"
              style={{
                ...S.fieldInput,
                fontFamily: "var(--font-mono, monospace)",
