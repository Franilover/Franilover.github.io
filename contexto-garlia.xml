"use client";

/**
 * PersonajeImagePickers.tsx
 * ───────────────────────────
 * Botones de selección de imagen específicos del editor de personajes
 * (cara y cuerpo). Componentes puros que reciben value/onChange por
 * props — no conocen de dónde viene el personaje.
 *
