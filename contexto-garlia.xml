              icono: <Gem size={10} />,
              activo: false,
              items: vinculos
                .map((v) => granos.find((g) => g.id === v.grano_id))
                .filter((g): g is Grano => !!g)
                .map((g) => ({ id: g.id, nombre: g.nombre })),
