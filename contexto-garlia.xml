              className="text-micro font-black uppercase tracking-tight"
              style={{
                color: toast.ok ? "var(--callout-success-title)" : "#ef4444",
              }}
            >
              {toast.msg}
            </span>
          </MotionDiv>
        )}
      </AnimatePresence>
    </div>
  );
}
