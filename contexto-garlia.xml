"use client";

/**
 * useGrupoSelector.ts
 * ─────────────────────
 * Carga grupos_mundo de tipo "items" filtrados por subtipo.
 * Reemplaza los hooks duplicados useTiposDeGrupoItems (subtipo "Tipo")
 * y useOrigenesDeGrupoItems (subtipo "Origen"), que eran idénticos
