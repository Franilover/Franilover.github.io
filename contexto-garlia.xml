                </div>
              );
            }}
              onMove={(id, x, y) => moverPosicion(id, x, y)}
              onDropOnItem={handleDropAgrupar}
              onDropInsideContainer={handleDropInsideContainer}
              onResizeItem={(id, ancho, alto) => redimensionar(id, ancho, alto)}
