const AdminDescubrimientos = lazy(() => import("@/domains/garlia/relaciones/editorRelaciones"));

type SubPanel = "aventuras" | "relaciones" | "monedas" | "manual";

const SUB_PANELES: { key: SubPanel; label: string; Icon: React.ElementType }[] = [
