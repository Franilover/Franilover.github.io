          </button>
        </div>

        <div className="flex-1 min-h-0 overflow-y-auto">
          <ElementoEditor
            key={elemento.id}
            elemento={elemento}
            todosLosElementos={todosLosElementos}
            onBack={onCerrar}
            onActualizar={onActualizar}
            onEliminar={
              onEliminar
                ? (id) => {
