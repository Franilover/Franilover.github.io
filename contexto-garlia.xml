      <div className="flex items-center gap-1.5 mb-4">
        <button
          type="button"
          onClick={guardar}
          className="flex-1 text-micro font-black uppercase tracking-widest px-2 py-1.5 rounded-lg bg-primary text-bg-main hover:opacity-90 transition-opacity"
        >
          Guardar
        </button>
        <button
          type="button"
          onClick={onDelete}
