        border: "1px solid color-mix(in srgb, var(--primary) 10%, transparent)",
        borderRadius: "2px",
        background: "color-mix(in srgb, var(--primary) 3%, transparent)",
      }}
      title={title}
    >
      <span
        className="text-micro font-black uppercase tracking-wider text-center leading-none"
