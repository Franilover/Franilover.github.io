              >
                <Check size={10} /> Guardar
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

// ─── MapaNuevo — canvas full height + overlays flotantes ─────────────────────
function MapaNuevo({
  MapaConPuntosComponent,
  detalles,
  entities: _entities,
  onDetalleUpdate: _onDetalleUpdate,
  onDetalleDelete: _onDetalleDelete,
  onOpenDetalleEditor: _onOpenDetalleEditor,
