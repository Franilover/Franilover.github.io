                  <X size={13} />
                </button>
                {modalEntidad.data.imagen_url && (
                  <div className="absolute bottom-0 left-0 right-0 px-6 pb-4">
                    <h2
                      className="font-serif italic capitalize leading-tight"
                      style={{
