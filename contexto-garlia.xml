 */

import { Camera, X } from "lucide-react";
import { useState } from "react";

import SimpleImagePicker from "@/ui/SimpleImagePicker";

// ─── Picker genérico (modal con título + icono configurable) ─────────────────

export function PickerImagen({
  onChange,
  titulo,
  icon,
  label,
}: {
  value: string;
