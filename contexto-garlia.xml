  rareza?: string;
  habitat?: string;
  alma?: string;
  reino?: string;
  especie?: string;
}

export interface ItemInventario {
  equipado: boolean;
  items: {
    id: string;
    nombre: string;
    categoria: string;
    imagen_url?: string;
    descripcion?: string;
